FROM node:24-bookworm-slim AS node

FROM ghcr.io/astral-sh/uv:latest AS uv

FROM python:3.13-slim-bookworm

COPY --from=node /usr/local /usr/local
COPY --from=uv /uv /uvx /bin/
RUN apt-get update && apt-get install -y --no-install-recommends build-essential pkg-config default-libmysqlclient-dev mariadb-client && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-install-project

COPY scripts/ scripts/

CMD ["bash", "-c", "bash scripts/init_schema.sh && uv run --locked scripts/etl.py && bash scripts/seed_users.sh"]
